# Experimental data IS committed (decision 2026-08-25, following
# github.com/robirahman/GPU-monitoring conventions): binary formats go
# through git LFS per .gitattributes. Only identifying media and network
# captures stay out.
*.pcap
*.pcapng
*.mp4
*.mov
*.avi

# Python and notebooks
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# LaTeX build products
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
/output/
/tmp/

# Local secrets and machine configuration
.env
secrets/
local_config.*
